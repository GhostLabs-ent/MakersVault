PUID=1000
PGID=1000
# Entrypoint only. `recursive` opts into a full data-tree ownership repair.
CHOWN_MODE=minimal
API_IMAGE=ghcr.io/insanemal/curiarium-api:edge
WEB_IMAGE=ghcr.io/insanemal/curiarium-web:edge
FILE_STORAGE=/app/storage
DB_URL=sqlite:///./curiarium.db
API_PORT=8000
PUBLIC_URL=
CORS_ORIGINS=
VITE_ALLOWED_HOSTS=
VITE_API_URL=
AUTH_USERNAME=admin
AUTH_PASSWORD=password
AUTH_SECRET=replace-with-random-secret
# Access tokens are short-lived JWTs; refresh tokens are opaque, stored hashed,
# and rotated once per use.
AUTH_ACCESS_TOKEN_TTL=900
AUTH_REFRESH_TTL_SECONDS=2592000
# AUTH_TOKEN_TTL is deprecated and ignored: an old .env that still sets it
# starts fine, but the value is a no-op.
# Direct upload cap in MB (0 disables). Match this in the reverse proxy.
MAX_UPLOAD_MB=4096
# Remote import response cap in MB (maximum body size for one link import).
IMPORT_MAX_MB=512
# Cumulative expanded-size budget in MB for the entries selected from one zip import.
IMPORT_ZIP_MAX_MB=2048
# Remote request time budget in seconds.
IMPORT_TIMEOUT_SECONDS=30
# Maximum redirect hops followed while fetching a remote import.
IMPORT_MAX_REDIRECTS=5
# Maximum resolver HTML size in KB.
IMPORT_HTML_MAX_KB=4096
# Per-supporting-file cap in MB. The cap in force is the smaller of this and
# IMPORT_MAX_MB, so removing this line follows IMPORT_MAX_MB. 0 removes this
# cap, but IMPORT_MAX_MB still applies.
ASSET_FILE_MAX_MB=512
# Total size in MB of one model's supporting files; 0 disables the check.
ASSET_FILE_TOTAL_MAX_MB=2048
# Maximum supporting files on one model; 0 disables the check.
ASSET_FILE_MAX_COUNT=50
# Optional server-side MakerWorld/Thingiverse session cookies for link imports.
# A value supplied by the browser wins, and cookies are never persisted.
MAKERWORLD_COOKIE=
THINGIVERSE_COOKIE=
# Startup guard: the API refuses to start while AUTH_PASSWORD/AUTH_SECRET are
# the published sample values. Set to 1 only for a throwaway local deployment
# that intentionally keeps them; never on a reachable host.
AUTH_ALLOW_INSECURE_DEFAULTS=0

# Login throttling. Failed logins are counted per submitted username; the single
# admin account locks out with escalating backoff once the limit is reached.
LOGIN_THROTTLE_ENABLED=true
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=300
LOGIN_MAX_LOCKOUT_SECONDS=3600

# OIDC / SSO (opt-in). Off by default: with OIDC_ENABLED=false the four OIDC
# routes answer 503 and local password login is unchanged. Turning SSO on does
# NOT turn password login off - both front doors stay open.
#
# A half-configuration refuses to boot: issuer, client id and client secret must
# all be set, at least one allow-list must be populated, OIDC_ISSUER must be
# https://, OIDC_ENABLED needs a non-empty PUBLIC_URL, and OIDC_ADMIN_GROUPS must
# stay empty (claims can never grant admin).
#
# The redirect URI is not a setting: it is derived as
# ${PUBLIC_URL}/auth/oidc/callback, so register exactly that with your IdP.
#
# The two allow-lists compose with AND: when both OIDC_ALLOWED_GROUPS and
# OIDC_ALLOWED_DOMAINS are set, a principal must satisfy both. A new SSO user
# gets the viewer role; OIDC_EDITOR_GROUPS is the only escalation a claim set can
# produce.
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_GROUPS_CLAIM=groups
OIDC_ALLOWED_GROUPS=
OIDC_ALLOWED_DOMAINS=
OIDC_EDITOR_GROUPS=
OIDC_ADMIN_GROUPS=

# Security headers sent by the bundled web Nginx.
# Empty value = built-in default. Literal `off` omits that single header.
# SECURITY_HEADERS_ENABLED=false disables all of them (for a proxy that already
# sets them, or an unusual setup that cannot tolerate them).
SECURITY_HEADERS_ENABLED=true
# max-age only by default; no includeSubDomains, no preload.
SECURITY_HEADERS_HSTS=
# Defaults to the built-in policy, whose connect-src also allows the configured
# absolute API origin. Override only if you know the sources you need.
SECURITY_HEADERS_CSP=
SECURITY_HEADERS_REFERRER_POLICY=
SECURITY_HEADERS_FRAME_OPTIONS=
SECURITY_HEADERS_PERMISSIONS_POLICY=
SECURITY_HEADERS_CONTENT_TYPE_OPTIONS=

# Pre-operation snapshots for the three destructive operations (folder delete,
# trash purge, bulk asset delete). `warn` proceeds without a snapshot and
# reports it; `strict` refuses only when SNAPSHOT_REQUIRE_CAPABILITY is true.
# A volume with no snapshot method (ext4, tmpfs) is an audited absence, not a
# failure, so Empty trash keeps working by default.
SNAPSHOT_POLICY_PREDELETE=warn
SNAPSHOT_POLICY_PREPURGE=strict
SNAPSHOT_POLICY_PREBULK=strict
SNAPSHOT_REQUIRE_CAPABILITY=false

# Scheduled library snapshots (S8). Off by default: the thread starts from the
# API's lifespan only when this is true, so a deployment that never opted in
# takes no snapshot behind the operator's back. The snapshot is a filesystem
# snapshot of the library volume and does NOT cover the SQLite database - pair
# it with a database backup (see docs/ARCHITECTURE_RUNBOOK.md, 9.3.1).
SNAPSHOT_SCHEDULE_ENABLED=false
# Take one when the newest scheduled snapshot is older than this many hours.
SNAPSHOT_SCHEDULE_HOURS=24
# How often the thread asks whether one is due.
SNAPSHOT_SCHEDULE_CHECK_SECONDS=300
# Keep the first tick clear of migrations and the boot guards.
SNAPSHOT_SCHEDULE_START_DELAY_SECONDS=60

# BTRFS snapshots are opt-in through a privileged sidecar: the API container
# holds no CAP_SYS_ADMIN, so it asks a sidecar to snapshot the library volume.
# Leave both empty to disable. See docs/architecture/CONFIGURATION.md,
# "Snapshots (BTRFS sidecar)".
SNAPSHOT_BTRFS_SIDECAR_URL=
SNAPSHOT_BTRFS_SIDECAR_TOKEN=
