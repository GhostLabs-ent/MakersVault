{
  "LoginRequest": {
    "properties": {
      "password": {
        "title": "Password",
        "type": "string"
      },
      "username": {
        "title": "Username",
        "type": "string"
      }
    },
    "required": [
      "username",
      "password"
    ],
    "title": "LoginRequest",
    "type": "object"
  },
  "LoginResponse": {
    "description": "A completed login, or the one step of it that is still outstanding.\n\nPassword-only and OIDC logins keep their existing body (`token`, `expires_in`,\n`refresh_token`, `token_type`) and report `mfa_required: false`. When the\naccount has a second factor, the same shape is returned with only\n`mfa_required: true` and `mfa_token` set; the token fields are optional so\nthat challenge validates. The client never has to guess which body it got.",
    "properties": {
      "expires_in": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "title": "Expires In"
      },
      "mfa_required": {
        "default": false,
        "title": "Mfa Required",
        "type": "boolean"
      },
      "mfa_token": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Mfa Token"
      },
      "refresh_token": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Refresh Token"
      },
      "token": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Token"
      },
      "token_type": {
        "default": "bearer",
        "title": "Token Type",
        "type": "string"
      }
    },
    "title": "LoginResponse",
    "type": "object"
  },
  "MeOut": {
    "properties": {
      "disabled": {
        "title": "Disabled",
        "type": "boolean"
      },
      "email": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Email"
      },
      "id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Id"
      },
      "kind": {
        "title": "Kind",
        "type": "string"
      },
      "role": {
        "title": "Role",
        "type": "string"
      },
      "username": {
        "title": "Username",
        "type": "string"
      }
    },
    "required": [
      "id",
      "username",
      "email",
      "role",
      "disabled",
      "kind"
    ],
    "title": "MeOut",
    "type": "object"
  },
  "OidcExchangeRequest": {
    "additionalProperties": false,
    "description": "The single-use handoff code the callback parked, taken from the fragment.",
    "properties": {
      "code": {
        "title": "Code",
        "type": "string"
      }
    },
    "required": [
      "code"
    ],
    "title": "OidcExchangeRequest",
    "type": "object"
  },
  "OidcStatusOut": {
    "description": "Whether the client should offer the SSO button; nothing else.\n\nDeliberately carries no provider name, issuer or error text: this route is\npublic, and the only decision the browser has to make is whether to draw a\nsecond button.",
    "properties": {
      "enabled": {
        "title": "Enabled",
        "type": "boolean"
      }
    },
    "required": [
      "enabled"
    ],
    "title": "OidcStatusOut",
    "type": "object"
  },
  "PasswordResetRequest": {
    "additionalProperties": false,
    "description": "An administrator replacing another account's password (Mf-bj51).\n\nBoth flags open a door that was deliberately shut, so neither is the default.\nSet on the request rather than inferred from the target's state, because the\naudit row has to say which door was opened and an operator has to mean it.",
    "properties": {
      "allow_disabled": {
        "default": false,
        "title": "Allow Disabled",
        "type": "boolean"
      },
      "allow_sso": {
        "default": false,
        "title": "Allow Sso",
        "type": "boolean"
      },
      "password": {
        "title": "Password",
        "type": "string"
      }
    },
    "required": [
      "password"
    ],
    "title": "PasswordResetRequest",
    "type": "object"
  },
  "RefreshRequest": {
    "properties": {
      "refresh_token": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Refresh Token"
      }
    },
    "title": "RefreshRequest",
    "type": "object"
  },
  "SessionOut": {
    "description": "One active session, as the owner or an administrator may see it.\n\nTimestamps are epoch seconds because the client renders relative times\n(\"last used 3 minutes ago\"), which would need a second parse from an ISO\nstring. Neither refresh hash is ever part of this contract: that is a\nsecurity boundary, not an oversight, so the model has no field for either and\nthe handler never passes one.",
    "properties": {
      "client_ip": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Client Ip"
      },
      "created_at": {
        "title": "Created At",
        "type": "integer"
      },
      "current": {
        "title": "Current",
        "type": "boolean"
      },
      "device": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Device"
      },
      "id": {
        "title": "Id",
        "type": "string"
      },
      "kind": {
        "title": "Kind",
        "type": "string"
      },
      "last_used_at": {
        "title": "Last Used At",
        "type": "integer"
      },
      "user_agent": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "User Agent"
      },
      "username": {
        "title": "Username",
        "type": "string"
      }
    },
    "required": [
      "id",
      "username",
      "kind",
      "device",
      "user_agent",
      "client_ip",
      "created_at",
      "last_used_at",
      "current"
    ],
    "title": "SessionOut",
    "type": "object"
  },
  "UserCreate": {
    "properties": {
      "email": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Email"
      },
      "password": {
        "title": "Password",
        "type": "string"
      },
      "role": {
        "default": "viewer",
        "title": "Role",
        "type": "string"
      },
      "username": {
        "title": "Username",
        "type": "string"
      }
    },
    "required": [
      "username",
      "password"
    ],
    "title": "UserCreate",
    "type": "object"
  },
  "UserOut": {
    "description": "One account as an administrator may see it; never a password hash.\n\n`auth_source` describes the *password credential*: `sso` is exactly\n`password_hash IS NULL` (the test `routers/mfa.py` already uses), so `local`\nmeans this account can sign in with a password. `oidc_issuer`/`oidc_subject`\ndescribe a different fact - the *binding* to a provider identity.\n\nThey are not either/or. An `allow_sso` password reset gives an\nSSO-provisioned account a local password as well, which is the operator's\nescape hatch when the identity provider is down (that is why\n`accounts.create_sso_user` refuses to mint an admin); such an account is\n`auth_source: \"local\"` *and* carries a binding, and the client renders both.",
    "properties": {
      "auth_source": {
        "default": "local",
        "enum": [
          "local",
          "sso"
        ],
        "title": "Auth Source",
        "type": "string"
      },
      "created_at": {
        "title": "Created At",
        "type": "string"
      },
      "disabled": {
        "title": "Disabled",
        "type": "boolean"
      },
      "email": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Email"
      },
      "id": {
        "title": "Id",
        "type": "string"
      },
      "oidc_issuer": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Oidc Issuer"
      },
      "oidc_subject": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Oidc Subject"
      },
      "role": {
        "title": "Role",
        "type": "string"
      },
      "updated_at": {
        "title": "Updated At",
        "type": "string"
      },
      "username": {
        "title": "Username",
        "type": "string"
      }
    },
    "required": [
      "id",
      "username",
      "email",
      "role",
      "disabled",
      "created_at",
      "updated_at"
    ],
    "title": "UserOut",
    "type": "object"
  },
  "UserUpdate": {
    "additionalProperties": false,
    "description": "Fields an administrator may change on an account (Mf-2nbc).\n\nBoth are optional so `{\"disabled\": true}` keeps working, and an empty patch\nis rejected instead of silently changing nothing.",
    "properties": {
      "disabled": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ],
        "title": "Disabled"
      },
      "role": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Role"
      }
    },
    "title": "UserUpdate",
    "type": "object"
  }
}
