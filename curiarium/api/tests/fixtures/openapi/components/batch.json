  "BatchMetaRequest": {
    "additionalProperties": false,
    "description": "A batch creator/notes edit (Mf-pnc2).\n\nOnly the two audit-exempt metadata fields are here. `title`/`name` are\ndeliberately absent: title is a rename alias, so a batch payload carrying it\nwould mass-rename files on disk. An absent field is unchanged, an explicit\n``null`` or a blank string clears, which diverges from the single endpoint's\n\"null is unchanged\" only because a batch has no meaningful \"typed nothing\".\nValues are validated once for the whole request, like `BatchFolderRequest`'s\n`folder_id`; a bad value fails the request, not one item per asset.",
    "properties": {
      "asset_ids": {
        "default": [],
        "items": {
          "type": "string"
        },
        "title": "Asset Ids",
        "type": "array"
      },
      "creator": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Creator"
      },
      "notes": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Notes"
      }
    },
    "title": "BatchMetaRequest",
    "type": "object"
  },
