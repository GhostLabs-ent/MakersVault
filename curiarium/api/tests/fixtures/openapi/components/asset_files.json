      "path",
      "url",
      "expires_at"
    ],
    "title": "FileGrantOut",
    "type": "object"
  },
  "FileGrantRequest": {
    "description": "The file URLs to mint grants for; bounds are checked in the handler.\n\nThe route validates emptiness and the maximum count so both are a readable\n400, not a 422 produced by the model layer.",
