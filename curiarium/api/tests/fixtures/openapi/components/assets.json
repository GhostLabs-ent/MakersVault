  "AssetMetaUpdate": {
    "description": "The single-asset metadata edit; validation happens before any rename.\n\nAn absent field is unchanged, a blank string clears (the legacy\n``strip() or None`` contract) and an explicit ``null`` is also unchanged:\nthe before-validator drops null keys so only a provided value can edit a\ncolumn. `collection` keeps that legacy behaviour and is not validated because\nADR 0003 retires it.",
    "properties": {
      "collection": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "deprecated": true,
        "description": "Legacy v5.1 metadata; inert since Mf-aoyv. Use Projects. Still accepted so old clients keep working.",
        "title": "Collection"
      },
      "creator": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Creator"
      },
      "name": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Name"
      },
      "notes": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Notes"
      },
      "title": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Title"
      }
    },
    "title": "AssetMetaUpdate",
    "type": "object"
  },
