          },
          {
            "type": "null"
          }
        ],
        "title": "Name"
      },
      "pattern": {
        "title": "Pattern",
        "type": "string"
      },
      "policy": {
        "enum": [
          "warn",
          "strict"
        ],
        "title": "Policy",
        "type": "string"
      },
      "reason": {
        "title": "Reason",
        "type": "string"
      }
    },
    "required": [
      "reason",
      "policy",
      "capability",
      "action",
      "pattern"
    ],
    "title": "SnapshotNoticeOut",
    "type": "object"
  },
