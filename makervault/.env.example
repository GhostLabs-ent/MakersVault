# Copying this file is not enough for production: AUTH_PASSWORD and AUTH_SECRET
# must be populated. Run ./scripts/setup-env.sh to generate a ready-to-use .env.
PUID=1000
PGID=1000
API_IMAGE=shotgunwilly555/makersvault-api:latest
WEB_IMAGE=shotgunwilly555/makersvault-web:latest
API_PORT=8000
WEB_PORT=5173
PUBLIC_URL=
CORS_ORIGINS=
VITE_API_URL=
VITE_ALLOWED_HOSTS=
AUTH_USERNAME=admin
AUTH_PASSWORD=
AUTH_SECRET=
AUTH_TOKEN_TTL=43200
FILE_MAX_MB=512
STORAGE_RESERVE_MB=512
ARCHIVE_MAX_ENTRIES=10000
ARCHIVE_MAX_SELECTED=1000
ARCHIVE_MAX_EXPANDED_MB=2048
ARCHIVE_MAX_RATIO=200
ARCHIVE_METADATA_MAX_MB=16
IMAGE_MAX_PIXELS=64000000
GENERATED_THUMBNAIL_MAX_MB=8
IMPORT_MAX_REDIRECTS=5
IMPORT_MOUNT_PATH=
IMPORT_MOUNT_PATH_HOST=./imports
IMPORT_MOUNT_EXTS=stl,3mf,step,stp,obj,svg,png,jpg,jpeg,webp,bmp,lbrn,lbrn2,zip
IMPORT_MOUNT_INCLUDE_HIDDEN=false
IMPORT_MOUNT_ON_STARTUP=false
IMPORT_MOUNT_COPY=true
