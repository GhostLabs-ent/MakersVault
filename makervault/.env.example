# Copying this file is not enough for production: AUTH_PASSWORD and AUTH_SECRET
# must be populated. Run ./scripts/setup-env.sh to generate a ready-to-use .env.
PUID=1000
PGID=1000
API_IMAGE=shotgunwilly555/makersvault-api:v5.1.0
WEB_IMAGE=shotgunwilly555/makersvault-web:v5.1.0
API_PORT=8000
WEB_PORT=5173
PUBLIC_URL=
CORS_ORIGINS=
TRUSTED_HOSTS=
VITE_API_URL=
VITE_ALLOWED_HOSTS=
AUTH_USERNAME=admin
AUTH_PASSWORD=
AUTH_SECRET=
AUTH_TOKEN_TTL=43200
FILE_MAX_MB=512
STORAGE_RESERVE_MB=512
ARCHIVE_MAX_ENTRIES=10000
ARCHIVE_MAX_SELECTED=1000
ARCHIVE_MAX_EXPANDED_MB=2048
ARCHIVE_MAX_RATIO=200
ARCHIVE_METADATA_MAX_MB=16
IMAGE_MAX_PIXELS=64000000
GENERATED_THUMBNAIL_MAX_MB=8
PREVIEW_POLICY_VERSION=1
PREVIEW_AUTO_MAX_MB=16
PREVIEW_AUTO_MAX_TRIANGLES=100000
PREVIEW_AUTO_3MF_EXPANDED_MB=64
PREVIEW_AUTO_3MF_ENTRIES=256
PREVIEW_AUTO_MEMORY_MB=128
PREVIEW_AUTO_TIMEOUT_SECONDS=10
PREVIEW_AUTO_QUEUE=8
PREVIEW_DETAIL_MAX_MB=64
PREVIEW_DETAIL_MAX_TRIANGLES=500000
PREVIEW_DETAIL_3MF_EXPANDED_MB=256
PREVIEW_DETAIL_3MF_ENTRIES=1000
PREVIEW_DETAIL_MEMORY_MB=256
PREVIEW_DETAIL_TIMEOUT_SECONDS=30
IMPORT_MAX_REDIRECTS=5
IMPORT_MOUNT_PATH=
