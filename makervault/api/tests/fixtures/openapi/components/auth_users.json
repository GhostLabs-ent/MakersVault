  "SessionOut": {
    "description": "One active session, as the owner or an administrator may see it.\n\nTimestamps are epoch seconds because the client renders relative times\n(\"last used 3 minutes ago\"), which would need a second parse from an ISO\nstring. Neither refresh hash is ever part of this contract: that is a\nsecurity boundary, not an oversight, so the model has no field for either and\nthe handler never passes one.",
    "properties": {
      "client_ip": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Client Ip"
      },
