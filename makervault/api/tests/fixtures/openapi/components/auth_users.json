        "title": "Last Used At",
        "type": "integer"
      },
      "user_agent": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "User Agent"
      },
      "username": {
        "title": "Username",
        "type": "string"
      }
    },
    "required": [
