# Local ticket store (tk)
.tickets/

# Scheduler lanes: one git worktree per ticket, never committed
.lanes/

# Plan-ahead queue: per-ticket Oracle plans and their timings (process state,
# like .tickets/). Gitignored BEFORE the first plan is written, or a plan file
# would ride a lane's diff and defeat the touch-set check in Phase 5.
.plans/

# pi agent workspace. The project's scheduler definition is shared on purpose - it
# is how a batch lands, and docs/TICKET_WORKFLOW.md points at it - but anything
# else a pi session drops in here (local overrides, per-user agents, caches) is
# not repo content.
.pi/*
!.pi/agents/
.pi/agents/*
!.pi/agents/scheduler.md

# Local secrets and environment overrides
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.venv/
venv/

# Runtime databases and journals
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Node and Vite
node_modules/
dist/
.vite/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Go and desktop bridge build output
curiarium/slicer-bridge/slicer-bridge
curiarium/slicer-bridge/slicer-bridge.exe
curiarium/slicer-bridge/bin/
curiarium/slicer-bridge/build/
curiarium/slicer-bridge/dist/

# Curiarium runtime content
curiarium/data/
curiarium/imports/
curiarium/api/storage/
curiarium/storage/

# IDE, operating-system, and temporary files
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo
*.tmp
*.temp
*.log
